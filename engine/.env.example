# ContextForge engine production environment
CONTEXTFORGE_ENV=production
CONTEXTFORGE_HOST=0.0.0.0
CONTEXTFORGE_PORT=8001
CONTEXTFORGE_WORKERS=2

# Comma-separated browser origins allowed to call the API.
# Example:
# CONTEXTFORGE_ALLOWED_ORIGINS=https://contextforge.example.com
CONTEXTFORGE_ALLOWED_ORIGINS=http://localhost:3000

# Optional Hugging Face token for higher download/rate limits.
HF_TOKEN=

# Production security controls
CONTEXTFORGE_MAX_REQUEST_BYTES=20971520
CONTEXTFORGE_RATE_LIMIT_ENABLED=false
CONTEXTFORGE_RATE_LIMIT_REQUESTS=600
CONTEXTFORGE_RATE_LIMIT_WINDOW_SECONDS=60
CONTEXTFORGE_FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Identity / server persistence foundation
CONTEXTFORGE_AUTH_MODE=disabled
CONTEXTFORGE_AUTH_TRUST_PROXY=
CONTEXTFORGE_SERVER_PERSISTENCE_ENABLED=false
CONTEXTFORGE_SERVER_PERSISTENCE_DB=data/contextforge.db
